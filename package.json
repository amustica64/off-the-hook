{
	"name": "off-the-hook",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check .",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "psql $DATABASE_URL -v ON_ERROR_STOP=1 -f db/migrations/0000_init.sql -f db/migrations/0001_rls_and_rpcs.sql",
		"db:seed": "psql $DATABASE_URL -v ON_ERROR_STOP=1 -f db/seed.sql",
		"db:proof": "psql $DATABASE_URL -f tests/rls/rls-proof.sql"
	},
	"dependencies": {
		"@fontsource-variable/fraunces": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.2",
		"framer-motion": "^12.43.0",
		"lucide-react": "^1.28.0",
		"next": "15.5.22",
		"next-mdx-remote": "^6.0.0",
		"next-themes": "^0.4.6",
		"postgres": "^3.4.9",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"server-only": "^0.0.1",
		"tailwind-merge": "^3.6.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@biomejs/biome": "^2.5.6",
		"@playwright/test": "^1.62.1",
		"@tailwindcss/postcss": "^4",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^6.0.5",
		"drizzle-kit": "^0.31.10",
		"jsdom": "^30.0.1",
		"tailwindcss": "^4",
		"typescript": "^5",
		"vitest": "^4.1.10"
	},
	"packageManager": "pnpm@10.28.0"
}
